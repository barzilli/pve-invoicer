[Unit]
Description=Hourly pve-invoicer snapshot

[Timer]
# The RRD API keeps 70 minutes of 1-minute data, so run every hour. A late or missed run is
# caught up from coarser 30-minute data, and Persistent=true runs once at boot if one was missed.
OnCalendar=*-*-* *:05:00
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
